{
  // F5 で、サーバーを起動してから、ブラウザ（Edge）でアプリを開く。
  // 先頭の構成が、F5 で選ばれる既定の構成。Chrome を使いたいときは、下の構成を選ぶ。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "English journey（Edge で開く）",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8800/",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "serve-frontend"
    }
  ]
}
